# Copy to terraform.tfvars and fill in.
#
# Image references live in compose/*.yaml. Edit those files when you
# need different images. Pin by digest when compose hashes are part of
# an admission policy. Verify a published image with:
#
#   gh attestation verify \
#     oci://ghcr.io/dstack-tee/service-mesh/mesh-sidecar:latest \
#     --repo Dstack-TEE/service-mesh
#
cluster_name           = "demo"
coordinator_replicas   = 3
webdemo_replicas       = 2
postgres_replicas      = 3

# Pin every CVM to one Phala Cloud node when testing a specific host.
# Find accessible node IDs with `phala nodes list`.
# node_id = 39

# Default STUN provider; replace with your own public STUN endpoint(s).
stun_urls = ["stun:stun.cloudflare.com:3478"]
# Broker URLs are derived automatically in the Terraform graph.
# No separate server, relay credentials, or Cloudflare account is required.

# Attestation admission is enabled by default. The Consul ACL management
# token is derived in-TEE on the coordinators (bootstrap-secrets); it is
# not a Terraform input and never appears in state.
# enable_attestation_admission = true
# kms                          = "phala"
# admission_expected_kms_public_key defaults to the public key for the
# default phala KMS backend. Override it when changing kms.
