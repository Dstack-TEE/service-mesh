variable "bootstrap_name" {
  type        = string
  description = "Stable instance name that owns the app's bootstrap CVM. Keep it unchanged when scaling."
}

variable "bootstrap_node_id" {
  type        = number
  default     = null
  description = "App-level bootstrap placement, for existing apps whose adopted slot does not manage node_id. Otherwise placement comes from the bootstrap instance entry."
}

variable "instances" {
  type = map(object({
    node_id = optional(number)
    env     = optional(map(string), {})
  }))
  description = "Named coordinator slots, with optional placement and per-instance environment values."

  validation {
    condition = length(var.instances) > 0 && alltrue([
      for name in keys(var.instances) : can(regex("^[A-Za-z][A-Za-z0-9-]{4,62}$", name))
    ])
    error_message = "Configure at least one instance; names must be 5-63 letters, digits, or hyphens, starting with a letter."
  }
  validation {
    condition     = alltrue([for instance in var.instances : !contains(keys(instance.env), "SIGNALING_URLS_JSON")])
    error_message = "SIGNALING_URLS_JSON is generated by the module; do not set it in instance env."
  }
}

variable "env" {
  type        = map(string)
  default     = {}
  description = "Shared environment values. Per-instance values take precedence."

  validation {
    condition     = !contains(keys(var.env), "SIGNALING_URLS_JSON")
    error_message = "SIGNALING_URLS_JSON is generated by the module; do not set it in shared env."
  }
}

variable "docker_compose" {
  type        = string
  description = "Coordinator Docker Compose YAML with literal, preferably digest-pinned images."
}

variable "image" {
  type        = string
  default     = null
  description = "Phala guest OS image."
}

variable "kms" {
  type    = string
  default = "phala"
}

variable "size" {
  type    = string
  default = "tdx.small"
}

variable "region" {
  type    = string
  default = "US-WEST-1"
}

variable "disk_size" {
  type    = number
  default = 20
}

variable "wait_timeout_seconds" {
  type    = number
  default = 600

  validation {
    condition     = var.wait_timeout_seconds > 0
    error_message = "wait_timeout_seconds must be positive."
  }
}
