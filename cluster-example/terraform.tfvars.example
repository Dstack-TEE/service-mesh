# Copy to terraform.tfvars and fill in.
#
# Defaults below point at the GHCR-published, Sigstore-attested images
# produced by .github/workflows/publish.yml. Pin to a
# specific commit by replacing `:latest` with `:sha-<full-sha>` (40-char
# git sha) — preferred for prod since `:latest` floats. Verify a tag
# came from this repo with:
#
#   gh attestation verify \
#     oci://ghcr.io/dstack-tee/service-mesh/mesh-sidecar:latest \
#     --repo Dstack-TEE/service-mesh
#
# For dev iteration, replace any single line with a `ttl.sh/...:24h`
# tag from `docker push ttl.sh/<name>-$(date +%s):24h`.

cluster_name           = "demo"
coordinator_replicas   = 3
worker_replicas        = 3
gateway_domain         = "dstack-pha-prod5.phala.network"

mesh_sidecar_image = "ghcr.io/dstack-tee/service-mesh/mesh-sidecar:latest"
webdemo_image      = "ghcr.io/dstack-tee/service-mesh/webdemo:latest"
patroni_image      = "ghcr.io/dstack-tee/service-mesh/patroni:latest"

# NAT traversal bootstrap settings. In the productized path these should
# come from Phala Cloud managed service-mesh infrastructure. Until that
# is available in your environment, run coordinator/docker-compose.yaml
# on a public-IP host and use its values here.
# external_coordinator_host  = "<managed-or-self-hosted-bootstrap-host>"
# external_signaling_url     = "http://<managed-or-self-hosted-bootstrap-host>:7000"
# external_turn_secret       = "<hex>"

# Attestation admission is enabled by default. Terraform generates the
# Consul management token when consul_management_token is empty.
# enable_attestation_admission = true
# consul_management_token      = "<optional-consul-acl-management-token>"
# dstack_verifier_image        = "dstacktee/dstack-verifier:0.5.9" # Pin by digest in production.
# kms                          = "phala"
# admission_expected_kms_public_key defaults to the public key for the
# default phala KMS backend. Override it when changing kms.
# production_profile           = true
# os_image                     = "dstack-0.5.7"
# When production_profile is true, Terraform launches the CVMs with
# os_image and admission requires dstack-verifier to prove the matching
# SHA-256 os_image_hash from preflight.
# Use the provider-normalized OS image name, not the full hash-suffixed
# display slug, to avoid read-back drift during refresh.
